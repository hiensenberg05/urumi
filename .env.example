# =================================================================
# URUMI TEAM MCP GATEWAY & PLATFORM CONFIGURATION (EXAMPLE TEMPLATE)
# =================================================================

# -----------------------------------------------------------------
# 1. LLM & AI Service (Groq)
# -----------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b

# -----------------------------------------------------------------
# 2. WooCommerce Store & Cluster Ingress
# -----------------------------------------------------------------
WC_URL=https://store.local
WC_HOST_HEADER=store.local
WC_VERIFY_SSL=false
WC_CONSUMER_KEY=ck_your_woocommerce_consumer_key
WC_CONSUMER_SECRET=cs_your_woocommerce_consumer_secret

# WordPress & MariaDB Credentials
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=your_wp_admin_password
MARIADB_ROOT_PASSWORD=your_mariadb_root_password
MARIADB_USER=wordpress
MARIADB_PASSWORD=your_mariadb_password
MARIADB_DATABASE=wordpress

# -----------------------------------------------------------------
# 3. Upstream MCP Servers (Streamable HTTP)
# -----------------------------------------------------------------
# In-Cluster DNS Endpoints
UPSTREAM_WOOCOMMERCE_URL=http://woocommerce-mcp.default.svc.cluster.local:8001/mcp
UPSTREAM_INVENTORY_URL=http://inventory-mcp.default.svc.cluster.local:8002/mcp
UPSTREAM_ANALYTICS_URL=http://analytics-mcp.default.svc.cluster.local:8003/mcp

# Local Development Fallbacks
LOCAL_WOOCOMMERCE_MCP_URL=http://localhost:8001/mcp
LOCAL_INVENTORY_MCP_URL=http://localhost:8002/mcp
LOCAL_ANALYTICS_MCP_URL=http://localhost:8003/mcp

# -----------------------------------------------------------------
# 4. Gateway Configuration & Pre-Provisioned RBAC API Keys
# -----------------------------------------------------------------
GATEWAY_PORT=8000
GATEWAY_HOST=0.0.0.0
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=15
JWT_SECRET=your_jwt_secret_change_in_production

# Default Team API Keys
ADMIN_API_KEY=admin-key-urumi-2026
INVENTORY_API_KEY=inv-key-urumi-2026
ANALYST_API_KEY=analyst-key-urumi-2026
SUPPORT_API_KEY=support-key-urumi-2026

# -----------------------------------------------------------------
# 5. Service Ports
# -----------------------------------------------------------------
FRONTEND_PORT=3000
GATEWAY_SERVICE_PORT=8000
WOOCOMMERCE_MCP_PORT=8001
INVENTORY_MCP_PORT=8002
ANALYTICS_MCP_PORT=8003
AI_SERVICE_PORT=8004

# -----------------------------------------------------------------
# 6. Frontend Environment Variables
# -----------------------------------------------------------------
VITE_GATEWAY_URL=http://localhost:8000
VITE_API_URL=/api/v1
VITE_DEFAULT_ADMIN_KEY=admin-key-urumi-2026
