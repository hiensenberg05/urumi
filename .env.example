# LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b

# Platform Database (PostgreSQL)
DATABASE_URL=postgresql://urumi_admin:urumi_password@localhost:5432/urumi_platform?schema=public

# WooCommerce Store & Database (MariaDB)
WOOCOMMERCE_URL=http://store.local
WOOCOMMERCE_CONSUMER_KEY=ck_test_key
WOOCOMMERCE_CONSUMER_SECRET=cs_test_secret

# Gateway & Backend Shared Secrets
INTERNAL_SERVICE_KEY=secret_internal_gateway_token_change_in_production
JWT_SECRET=super_secret_jwt_key_change_in_production

# Service Ports (Local development)
FRONTEND_PORT=3000
BACKEND_PORT=4000
GATEWAY_PORT=5000
AI_SERVICE_PORT=8000
WOOCOMMERCE_MCP_PORT=8001
INVENTORY_MCP_PORT=8002
ANALYTICS_MCP_PORT=8003
